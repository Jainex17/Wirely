NEON_AUTH_BASE_URL=https://example.neon.tech
NEON_AUTH_LOGIN_URL=https://example.neon.tech
NEON_AUTH_COOKIE_SECRET=replace_with_long_random_secret
NEON_AUTH_ISSUER=https://example.neon.tech
NEON_AUTH_AUDIENCE=your_audience
