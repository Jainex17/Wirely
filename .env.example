DATABASE_URL=postgresql://user:password@host/database?sslmode=require
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_DIRECTORY=/Users/yourname/projects/your-project
OPENCODE_AGENT=build
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=
USER_API_KEY_MASTER_SECRET_BASE64=replace_with_32byte_or_longer_base64_secret
USER_API_KEY_KEY_VERSION=1
USER_API_KEY_PREVIOUS_MASTER_SECRET_BASE64=
REQUEST_BODY_MAX_BYTES=65536
DB_POOL_MAX=5
DB_POOL_CONNECTION_TIMEOUT_MS=3000
DB_POOL_IDLE_TIMEOUT_MS=10000

NEON_AUTH_BASE_URL=https://example.neon.tech
NEON_AUTH_LOGIN_URL=https://example.neon.tech
NEON_AUTH_COOKIE_SECRET=replace_with_long_random_secret
NEON_AUTH_ISSUER=https://example.neon.tech
NEON_AUTH_AUDIENCE=your_audience
NEON_AUTH_JWKS_URL=https://example.neon.tech/.well-known/jwks.json
